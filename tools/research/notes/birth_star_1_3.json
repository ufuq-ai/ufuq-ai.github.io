 "entries": [
  {
   "id": "K312",
   "section": "astronomy",
   "q": "كيف يعرف العلماء بُعد النجوم؟",
   "keywords": "كم تبعد النجوم كم يبعد النجم قياس مسافات النجوم تقاس المسافات مسافة النجوم كيف نقيس المسافة الى النجوم اختلاف المنظر هيباركوس غايا parallax Hipparcos Gaia star distance",
   "a": "بطريقة تُسمى «اختلاف المنظر»: يرصد العلماء النجم مرتين بينهما نحو نصف سنة، حين تكون الأرض في جهتين متقابلتين من مدارها حول الشمس، فيبدو النجم كأنه تحرك قليلًا أمام النجوم الأبعد منه، ومن مقدار هذه الحركة الصغيرة يحسبون بُعده. وبهذه الطريقة قاس القمر الصناعي «هيباركوس» التابع لوكالة الفضاء الأوروبية، بين نوفمبر 1989 ومارس 1993، مواقع 118,218 نجمًا بأعلى دقة، ومنها بُعد كل نجم، ثم جاءت بعده مهمة «غايا» فزادت قياساته دقة.",
   "tag": "",
   "inference": false,
   "source_name": "وكالة الفضاء الأوروبية",
